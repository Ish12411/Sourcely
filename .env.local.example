# Copy this file to `.env.local` and paste your keys in.
# `.env.local` is gitignored — your keys never leave your machine or your server.
#
# IMPORTANT: keep the NAME= part of each line. Replace only the value after the "=".

# --- Required ---

# Tavily — https://app.tavily.com  (free tier, key starts with "tvly-")
TAVILY_API_KEY=tvly-your-key-here

# Google Gemini — https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY=your-gemini-key-here

# --- Optional: group tabs / share links ---
# Without these, personal tabs work fine and group tabs stay local to this
# browser. See the README for the one table Supabase needs.
# Project URL, e.g. https://abcdefgh.supabase.co
# SUPABASE_URL=
# The service_role key (Project Settings -> API). Server-side only — it is
# never sent to the browser, so it must NOT be prefixed with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Optional overrides ---
# GEMINI_MODEL=gemini-3.6-flash-lite
# MAX_SOURCES=8
